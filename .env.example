# Mise — environment variables
#
# Copy this file to ".env.local" and fill in the values. ".env.local" is git-ignored.
# Every variable is optional: without keys the app runs on live OpenStreetMap data.

# ── Server-side keys (never sent to the browser) ─────────────────────────────────────

# Google Places API (New): ratings, reviews, opening hours, price, outdoor seating.
# https://console.cloud.google.com/apis/library/places.googleapis.com
# Recommended: API restriction = places.googleapis.com, and a daily SearchNearbyRequest quota
# below the free tier (one search = 3 requests).
GOOGLE_PLACES_API_KEY=

# Foursquare Places API (2025): popular venues (free tier); ratings require account credits.
# https://foursquare.com/developers
FOURSQUARE_API_KEY=

# Set to 1 to request Foursquare's premium fields (rating, hours, photos) — requires credits.
FOURSQUARE_PREMIUM=0

# ── Browser key (PUBLIC by design — embedded in the page bundle) ─────────────────────

# Google Places UI Kit: Google's own place card for matched venues when the search quota is exhausted.
# MUST be restricted in Google Cloud:
#   API restriction:      placewidgets.googleapis.com + maps-backend.googleapis.com
#   Website restriction:  your own domain + http://localhost:3000/*
#   Daily quotas:         PlacesUiKitQueryRequest ≤ 160, Map loads = 0
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
